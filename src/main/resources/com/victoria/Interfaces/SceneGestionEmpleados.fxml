<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.victoria.Interfaces.GestionEmpleado">

    <!-- Título -->
    <top>
        <Label text="GESTIÓN DE EMPLEADOS"
               BorderPane.alignment="CENTER"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    </top>

    <!-- Tabla -->
    <center>
        <TableView fx:id="tablaEmpleados" prefHeight="400" prefWidth="900">

            <columns>
                <TableColumn fx:id="colDni" text="DNI" prefWidth="120"/>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="140"/>
                <TableColumn fx:id="colApellido" text="Apellido" prefWidth="140"/>
                <TableColumn fx:id="colDireccion" text="Dirección" prefWidth="220"/>
                <TableColumn fx:id="colFechaAlta" text="Fecha de Alta" prefWidth="180"/>

                <TableColumn fx:id="colModificar" text="Modificar" prefWidth="100"/>
                <TableColumn fx:id="colEliminar" text="Eliminar" prefWidth="100"/>
            </columns>

        </TableView>
    </center>

    <!-- Botón volver -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>
             <Button text="Agregar Empleado"
                onAction="#irARegistroEmpleado"/>
                
            <Button text="Volver al Menú Principal"
                    onAction="#volverMenuPrincipal"/>

        </HBox>
    </bottom>

</BorderPane>