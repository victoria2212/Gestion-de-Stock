<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.victoria.Interfaces.GestionEmpleado"
            stylesheets="@../styles/estilo-gestion-empleados.css">

    <!-- Título -->
    <top>
        <VBox spacing="10">

            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cabecera-titulo">

                <VBox.margin>
                    <Insets top="30" left="20" right="20" bottom="20"/>
                </VBox.margin>

                <HBox alignment="CENTER" spacing="6" styleClass="badge-contador">
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@../images/iconopersona.png"/>
                    </image>
                </ImageView>
                    <Label fx:id="lblCantidadEmpleados" text="0 empleados" styleClass="badge-texto"/>
                </HBox>

                <VBox styleClass="bloque-titulo">
                    <Label text="Gestión de empleados"
                           styleClass="titulo"/>
                    <Label text="Gestioná los datos y la información de tu equipo"
                           styleClass="subtitulo-stock"/>
                </VBox>

            </HBox>

        </VBox>
    </top>

    <!-- Tarjetas de empleados -->
    <center>
        <StackPane>

            <!-- Logo de fondo, como marca de agua -->
                <ImageView fitWidth="520" preserveRatio="true"
                    opacity="0.09"
                    smooth="true"
                    mouseTransparent="true">
                <image>
                    <Image url="@../images/logodharmavip.png"
                        backgroundLoading="false"/>
                </image>
            </ImageView>

            <!-- Contenido real, por encima del logo -->
            <ScrollPane fitToWidth="true" styleClass="scroll-empleados">

                <content>

                    <FlowPane fx:id="contenedorEmpleados"
                            hgap="16"
                            vgap="16"
                            styleClass="grid-empleados">

                        <padding>
                            <Insets top="10" right="20" bottom="20" left="20"/>
                        </padding>

                    </FlowPane>

                </content>

            </ScrollPane>

        </StackPane>
    </center>

    <!-- Botones inferiores -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button text="+ Agregar Empleado"
                    onAction="#irARegistroEmpleado"
                    styleClass="btn-principal"/>

            <Button text="← Menú Principal"
                    onAction="#volverMenuPrincipal"
                    styleClass="btn-principal"/>

        </HBox>
    </bottom>

</BorderPane>