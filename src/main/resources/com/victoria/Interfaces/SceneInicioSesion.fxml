<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.Insets?>

<StackPane
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="com.victoria.Interfaces.InicioSesion"
    styleClass="root-pane"
    stylesheets="@../styles/estilo-inicio-sesion.css">

    <VBox alignment="CENTER" styleClass="background-pane">

        <VBox alignment="CENTER" spacing="0" styleClass="login-card">

            <!-- Logo -->
            <StackPane styleClass="logo-circle">
                <ImageView fitWidth="270" fitHeight="270" preserveRatio="true" smooth="true">
                <image>
                    <Image url="@../images/logodharmavip.png" requestedWidth="400" requestedHeight="400"/>
                </image>
            </ImageView>
            </StackPane>

            <Region prefHeight="4" />

            <Label text="Sistema de Gestión de Stock" styleClass="titulo-principal" maxWidth="Infinity" />
            <Label text="Ingresá tu DNI para continuar" styleClass="subtitulo" maxWidth="Infinity" />

            <Region prefHeight="20" />

            <Label text="DNI" styleClass="field-label" maxWidth="Infinity" />

            <HBox styleClass="field-wrap" alignment="CENTER_LEFT">
                <TextField fx:id="campoDni" promptText="Ej: 12345678"
                           styleClass="field-input" maxWidth="Infinity"
                           HBox.hgrow="ALWAYS" />
            </HBox>

            <Region prefHeight="16" />

            <Button text="Ingresar" onAction="#handleIngresar"
                    defaultButton="true"
                    styleClass="btn-ingresar"
                    maxWidth="Infinity" />

            <Region prefHeight="16" />
            <Separator styleClass="divider" maxWidth="Infinity" />
            <Region prefHeight="16" />

        </VBox>
    </VBox>
</StackPane>