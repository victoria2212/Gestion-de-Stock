<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.victoria.Interfaces.RegistroEmpleado"
           style="-fx-background-color: #BDD5E5;"
           alignment="CENTER">

    <!-- CARD BLANCA centrada -->
    <VBox spacing="14" alignment="TOP_CENTER"
          style="-fx-background-color: white;
                 -fx-background-radius: 16;
                 -fx-border-radius: 16;
                 -fx-padding: 28 36 28 36;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.10), 16, 0, 0, 4);"
          maxWidth="560" maxHeight="560"
          StackPane.alignment="CENTER">

        <!-- Título -->
        <Label text="Alta de Empleado"
               style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1a2a4a;"
               alignment="CENTER" maxWidth="Infinity"/>
        <Label text="Completá los datos del nuevo empleado"
               style="-fx-font-size: 13px; -fx-text-fill: #6b7c99;"
               alignment="CENTER" maxWidth="Infinity"/>

        <Separator/>

        <!-- Formulario -->
        <GridPane hgap="12" vgap="10">
            <columnConstraints>
                <ColumnConstraints minWidth="150" halignment="RIGHT"/>
                <ColumnConstraints minWidth="280"/>
            </columnConstraints>

            <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <TextField fx:id="campoNombre" promptText="Nombre completo" prefWidth="280"
                       GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                              -fx-padding: 6 10 6 10;"/>

            <Label text="Apellido" GridPane.rowIndex="1" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <TextField fx:id="campoApellido" promptText="Apellido completo" prefWidth="280"
                       GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                              -fx-padding: 6 10 6 10;"/>

            <Label text="DNI" GridPane.rowIndex="2" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <TextField fx:id="campoDni" promptText="Solo números" prefWidth="280"
                       GridPane.rowIndex="2" GridPane.columnIndex="1"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                              -fx-padding: 6 10 6 10;"/>

            <Label text="Dirección" GridPane.rowIndex="3" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <TextField fx:id="campoDireccion" promptText="Ej: 25 de Mayo 123" prefWidth="280"
                       GridPane.rowIndex="3" GridPane.columnIndex="1"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                              -fx-padding: 6 10 6 10;"/>

            <Label text="Contacto (Celular)" GridPane.rowIndex="4" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <TextField fx:id="campoContacto" promptText="Solo números" prefWidth="280"
                       GridPane.rowIndex="4" GridPane.columnIndex="1"
                       style="-fx-background-radius: 8; -fx-border-radius: 8;
                              -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                              -fx-padding: 6 10 6 10;"/>

            <Label text="Rol" GridPane.rowIndex="5" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <ComboBox fx:id="campoRol" promptText="Seleccione un rol" prefWidth="280"
                      GridPane.rowIndex="5" GridPane.columnIndex="1"
                      style="-fx-background-radius: 8; -fx-border-radius: 8;
                             -fx-border-color: #c5d5e8; -fx-font-size: 13px;"/>

            <Label text="Contraseña Admin" GridPane.rowIndex="6" GridPane.columnIndex="0"
                   style="-fx-font-size: 13px; -fx-text-fill: #1a2a4a;"/>
            <HBox spacing="6" alignment="CENTER_LEFT"
                  GridPane.rowIndex="6" GridPane.columnIndex="1">
                <PasswordField fx:id="campoContrasenaAdmin" promptText="Ingrese la contraseña"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-radius: 8; -fx-border-radius: 8;
                                      -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                                      -fx-padding: 6 10 6 10;"/>
                <TextField fx:id="campoContrasenaAdminVisible" promptText="Ingrese la contraseña"
                           HBox.hgrow="ALWAYS" visible="false" managed="false"
                           style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #c5d5e8; -fx-font-size: 13px;
                                  -fx-padding: 6 10 6 10;"/>
                <Button fx:id="botonVerContrasena" text="👁" onAction="#toggleVerContrasena"
                        focusTraversable="false"
                        style="-fx-background-color: transparent;
                               -fx-border-color: #c5d5e8;
                               -fx-border-radius: 8;
                               -fx-background-radius: 8;
                               -fx-cursor: hand;
                               -fx-padding: 5 10 5 10;"/>
            </HBox>
        </GridPane>

        <Separator/>

        <!-- Botón Guardar -->
        <Button text="Registrar Empleado" onAction="#registrarEmpleado"
                maxWidth="Infinity" prefHeight="40"
                style="-fx-background-color: #4a7ab5;
                       -fx-text-fill: white;
                       -fx-font-size: 14px;
                       -fx-font-weight: bold;
                       -fx-background-radius: 10;
                       -fx-border-radius: 10;
                       -fx-cursor: hand;"/>

        <!-- Botón Volver -->
        <HBox alignment="CENTER_RIGHT">
            <Button text="← Volver" onAction="#inicioSesion"
                    style="-fx-background-color: transparent;
                           -fx-border-color: #4a7ab5;
                           -fx-border-radius: 8;
                           -fx-background-radius: 8;
                           -fx-text-fill: #4a7ab5;
                           -fx-font-size: 12px;
                           -fx-cursor: hand;
                           -fx-padding: 5 12 5 12;"/>
        </HBox>

    </VBox>
</StackPane>
