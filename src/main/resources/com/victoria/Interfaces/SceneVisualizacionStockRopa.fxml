<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.victoria.Interfaces.VisualizarStockRopa"
            stylesheets="@../styles/estilo-visualizador-stock.css">

    <!-- TITULO + BUSCADOR -->
    <top>
    <VBox spacing="10">

        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="cabecera-titulo">

            <VBox.margin>
                <Insets top="30" left="20" right="20"/>
            </VBox.margin>

            <HBox alignment="CENTER" spacing="6" styleClass="badge-contador">
                <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                    <image>
                        <Image url="@../images/iconoremera.png"/>
                    </image>
                </ImageView>
                <Label fx:id="lblCantidadProductos" text="0 productos" styleClass="badge-texto"/>
            </HBox>

            <VBox styleClass="bloque-titulo">
                <Label text="Stock de Ropa"
                       styleClass="titulo"/>
                <Label text="Consultá el inventario disponible"
                       styleClass="subtitulo-stock"/>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

            <TextField fx:id="txtBuscar"
                       promptText="🔍 Buscar ropa..."
                       prefWidth="280"/>

        </HBox>

    </VBox>
</top>

    <!-- TABLA -->
    <center>
        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="0" left="15"/>
            </padding>

            <TableView fx:id="tablaStock"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colTipoRopa" text="Tipo de Ropa"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción"/>
                    <TableColumn fx:id="colTalle" text="Talle"/>
                    <TableColumn fx:id="colPrecio" text="Precio"/>
                    <TableColumn fx:id="colColor" text="Color"/>
                    <TableColumn fx:id="colMarca" text="Marca"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad"/>
                    <TableColumn fx:id="colCodigo" text="Código"/>
                    <TableColumn fx:id="colFechaActualizacion" text="Última fecha de Modificación"/>
                    <TableColumn fx:id="colImagen" text="Imagen"/>
                </columns>

            </TableView>

        </VBox>
    </center>

    <!-- BOTON VOLVER -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="btnVolver"
                    text="← Volver al Menú Principal"
                    onAction="#volverMenuPrincipal"
                    styleClass="btn-volver"/>

        </HBox>
    </bottom>

</BorderPane>