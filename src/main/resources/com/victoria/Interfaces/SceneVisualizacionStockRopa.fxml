<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.victoria.Interfaces.VisualizarStockRopa"
            stylesheets="@../styles/estilo-visualizador-stock.css">

    <!-- TITULO + BUSCADOR -->
    <top>
        <VBox spacing="10">

            <Label text="STOCK DE ROPA"
                   styleClass="titulo"
                   maxWidth="Infinity"
                   alignment="CENTER"/>

            <HBox alignment="CENTER_RIGHT">
                <padding>
                    <Insets right="20"/>
                </padding>

                <TextField fx:id="txtBuscar"
                           promptText="🔍 Buscar prenda..."
                           prefWidth="280"/>
            </HBox>

        </VBox>
    </top>

    <!-- TABLA -->
    <center>
        <VBox spacing="10">

            <padding>
                <Insets top="15" right="15" bottom="0" left="15"/>
            </padding>

            <TableView fx:id="tablaStock"
                       VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colTipoRopa" text="Tipo de Ropa"/>
                    <TableColumn fx:id="colDescripcion" text="Descripción"/>
                    <TableColumn fx:id="colTalle" text="Talle"/>
                    <TableColumn fx:id="colPrecio" text="Precio"/>
                    <TableColumn fx:id="colColor" text="Color"/>
                    <TableColumn fx:id="colMarca" text="Marca"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad"/>
                    <TableColumn fx:id="colCodigo" text="Código"/>
                    <TableColumn fx:id="colFechaActualizacion" text="Última fecha de Modificación"/>
                    <TableColumn fx:id="colImagen" text="Imagen"/>
                </columns>

            </TableView>

        </VBox>
    </center>

    <!-- BOTON VOLVER -->
    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10">

            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button fx:id="btnVolver"
                    text="← Volver al Menú Principal"
                    onAction="#volverMenuPrincipal"
                    styleClass="btn-volver"/>

        </HBox>
    </bottom>

</BorderPane>